# Environment variables for KapAble local development.
# Copy this file to ".env" and fill in what you need. Your actual .env file
# should NOT be committed.
#
# Nothing here is required: KapAble runs bring-your-own-key and provider keys
# can be entered from Settings > AI instead.


# --- AI provider API keys (optional) ------------------------------------
# Supplying a key here is an alternative to entering it in the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# --- Local AI models (optional) -----------------------------------------
# Set if you run local models via Ollama or LM Studio.
# Ollama's default is http://127.0.0.1:11434
OLLAMA_HOST=


# --- GitHub integration (optional) --------------------------------------
# Needed only for features that push generated apps to GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=


# --- Hosted services (optional, all disabled by default) ----------------
# KapAble does not operate any hosted backend. Each variable below turns on a
# feature by pointing it at a deployment you run yourself. Left blank, the
# feature stays off and the app falls back to local behaviour instead of
# calling a host that does not exist.
# See docs/README.md#hosted-services.

# Managed OpenAI-compatible LLM gateway.
KAPABLE_ENGINE_URL=

# Base URL serving the model catalog, MCP catalog and desktop config.
# Without it, the model list bundled in the app is used.
KAPABLE_API_URL=

# Subscription/billing portal. Without it, upgrade prompts stay hidden.
KAPABLE_ACCOUNT_URL=

# OAuth broker for the Supabase and Neon integrations.
KAPABLE_OAUTH_URL=

# Destination for uploaded bug-report log bundles.
KAPABLE_LOG_UPLOAD_URL=

# Electron update feed. Without it, auto-update stays off.
KAPABLE_UPDATE_FEED_URL=

# Product analytics (build-time, read by the renderer). Without a key, no
# analytics client is active and no analytics requests are made.
VITE_KAPABLE_POSTHOG_KEY=
VITE_KAPABLE_POSTHOG_HOST=


# --- Individual endpoint overrides (advanced) ---------------------------
# These take precedence over KAPABLE_API_URL when set.
# KAPABLE_LANGUAGE_MODEL_CATALOG_URL=
# KAPABLE_MCP_CATALOG_URL=
# KAPABLE_DESKTOP_CONFIG_URL=


# --- macOS release signing (build only) ---------------------------------
# Only needed to build and notarize a signed macOS release.
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
SM_CODE_SIGNING_CERT_SHA1=


# --- Development & testing (advanced) -----------------------------------
# NODE_ENV=development
# E2E_TEST_BUILD=
# CI=
